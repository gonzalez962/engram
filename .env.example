# Engram Cloud — production-like local stack template
#
# Copy this file to `.env` (sibling of docker-compose.prod-local.yml) and
# replace every `replace-with-*` placeholder with a strong, unique secret.
# The `.env` file is in .gitignore and must NEVER be committed.
#
# Generating secrets on PowerShell (Windows):
#   function New-EngramSecret([int]$Bytes = 32) {
#       $b = New-Object byte[] $Bytes
#       [System.Security.Cryptography.RandomNumberGenerator]::Fill($b)
#       [Convert]::ToBase64String($b)
#   }
#   New-EngramSecret     # 32-byte base64 secret
#
# Generating secrets on macOS / Linux:
#   openssl rand -base64 32
#
# See docs/engram-cloud/prod-local.md for the full workflow.

# --- Postgres service (consumed by docker-compose.prod-local.yml) ---
POSTGRES_USER=engram
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=engram_cloud

# --- Engram cloud server ---
# Connection DSN is composed by docker-compose.prod-local.yml from the
# POSTGRES_* values; no override needed here.

# 32+ byte random secret. Required because the server starts in
# authenticated mode (ENGRAM_CLOUD_INSECURE_NO_AUTH is unset).
ENGRAM_JWT_SECRET=replace-with-32+-byte-random-secret

# Legacy sync bearer token. The server still requires a non-empty value
# at startup, even though the managed-admin work uses managed tokens.
ENGRAM_CLOUD_TOKEN=replace-with-32+-byte-random-sync-token

# Dashboard admin token (cookie flow). Must be distinct from
# ENGRAM_CLOUD_TOKEN.
ENGRAM_CLOUD_ADMIN=replace-with-32+-byte-random-admin-token

# Dedicated secret for hashing managed tokens. Distinct from
# ENGRAM_JWT_SECRET. Required for `engram cloud bootstrap admin --issue-token`
# and for the issued tokens to authenticate against this server.
ENGRAM_CLOUD_TOKEN_PEPPER=replace-with-32+-byte-random-pepper

# Required by validateCloudServeAuthConfig at startup. Managed principals
# authorize against cloud_project_grants and do NOT use this allowlist;
# any non-empty comma-separated value satisfies validation.
ENGRAM_CLOUD_ALLOWED_PROJECTS=bootstrap-only
